# Copia este archivo a `.env` y rellena los valores. `.env` no se versiona.

# Prisma Postgres. La escribe `prisma postgres link`.
DATABASE_URL=

# Cloudflare R2: retratos de las credenciales.
# Panel de Cloudflare → R2 → el ID de cuenta está en la barra derecha.
R2_ACCOUNT_ID=
# R2 → «Manage API tokens» → token de tipo *Object Read & Write* sobre el bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nombre del bucket, p. ej. conexion500-credenciales
R2_BUCKET=
# Base pública de lectura, sin barra final: el subdominio r2.dev del bucket
# (Settings → Public Development URL) o un dominio propio conectado al bucket.
R2_PUBLIC_BASE_URL=https://pub-afc673f5a0d34c36ac2107c949e8a854.r2.dev
# Orígenes autorizados a subir desde el navegador, separados por comas.
R2_CORS_ORIGINS=http://localhost:3000,https://conexion-natura.vercel.app/
