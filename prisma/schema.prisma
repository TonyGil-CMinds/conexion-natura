// Esquema de Conexión500. Primer corte: solo el registro de asistentes.
//
// La cadena de conexión no va aquí: en Prisma 7 la aporta `prisma.config.ts`
// desde `DATABASE_URL`, así que el esquema no toca secretos.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Una de las 100 invitaciones. Es la llave para registrarse: el sitio dice
/// «eres uno de los 100 invitados», así que el cupo se controla aquí y no
/// contando filas de asistentes.
model Invitation {
  id        String    @id @default(cuid())
  /// Código que llega en la invitación. Se compara en mayúsculas.
  code      String    @unique
  /// Correo al que se envió, cuando se conoce. No es el del registro: quien
  /// recibe la invitación puede registrarse con otra dirección.
  email     String?
  createdAt DateTime  @default(now())
  /// Nulo mientras nadie la haya usado.
  attendee  Attendee?

  @@index([email])
}

/// A cuál de los dos eventos asiste. Son los dos actos del mismo día: la noche
/// de Natura500 y la premiación de la mañana en GET Forum.
enum EventChoice {
  NIGHT
  AWARD
}

/// En qué punto está un registro.
///
/// `PENDING` es quien ha sido **invitado por otro asistente**: de él solo se
/// conoce el nombre y el correo, porque el resto lo rellena él mismo desde el
/// enlace que le llega. `CONFIRMED` es quien completó su registro, sea por su
/// cuenta o viniendo de una invitación.
enum AttendanceStatus {
  PENDING
  CONFIRMED
}

/// Una persona en la lista. Puede estar **pendiente** —invitada por otra y sin
/// completar— o **confirmada**, que es el contenido del formulario de
/// `/registro`.
model Attendee {
  id     String @id @default(cuid())
  /// Identifica al asistente: un correo, un registro.
  email  String @unique
  name   String
  surname String @default("")
  /// Vacíos mientras la invitación está pendiente: de un invitado solo se sabe
  /// el nombre y el correo hasta que entra a completar su registro. Que estén
  /// vacíos no es un dato a medias por descuido, lo dice `status`.
  organization String @default("")
  role         String @default("")
  /// Opcional en el formulario; se guarda ya normalizado a URL completa.
  linkedin     String?
  /// La fotografía se sube aparte: aquí solo queda su ubicación.
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Cuándo se envió el correo de confirmación. Nulo mientras no se haya
  /// enviado: reenviar el formulario corrige los datos y no debe repetir el
  /// correo, y si el envío falla la fila queda marcada para reintentarlo.
  /// Eventos elegidos. Es una lista porque la elección es múltiple: se puede
  /// asistir a los dos. Vacía mientras el registro no haya llegado a ese paso.
  events EventChoice[]

  /// Si dijo que trae invitado. Se guarda aparte de la fila del invitado porque
  /// se responde antes de tener sus datos, y porque un `false` explícito dice
  /// algo distinto de una fila que falta.
  bringsGuest Boolean @default(false)

  /// Pendiente o confirmado. Por omisión confirmado: quien llega por el
  /// formulario lo completa entero, y solo las invitaciones nacen pendientes.
  status AttendanceStatus @default(CONFIRMED)

  /**
   * Testigo del enlace de invitación.
   *
   * Es lo que identifica al invitado cuando abre el correo, en vez del propio
   * correo: con el correo en la URL, cambiar la dirección a mano abriría el
   * registro de otra persona. Se borra al completar el registro, así que el
   * enlace deja de servir en cuanto se usa.
   */
  inviteToken  String?   @unique
  /// Cuándo salió el correo de invitación. Nulo mientras no se haya enviado.
  inviteSentAt DateTime?

  /// Quién invitó a esta persona, si llegó por invitación.
  invitedById String?
  invitedBy   Attendee?  @relation("Guests", fields: [invitedById], references: [id], onDelete: SetNull)
  /// A quién ha invitado. Es una lista por si algún día se admite más de uno.
  guests      Attendee[] @relation("Guests")

  confirmationSentAt DateTime?

  /// Cada invitación admite un solo registro, de ahí el `@unique`.
  invitationId String?     @unique
  invitation   Invitation? @relation(fields: [invitationId], references: [id])
}

// El modelo `Companion` se retiró: quien viene acompañado ya no rellena los
// datos de la otra persona. Ahora indica su nombre y su correo, y esa persona
// entra en la lista como un `Attendee` en `PENDING` que completa su registro
// —sus actos, su fotografía, su credencial— desde el enlace que le llega. Un
// acompañante necesitaba exactamente lo mismo que un asistente, así que tener
// dos modelos era tener dos sitios donde arreglar lo mismo.
