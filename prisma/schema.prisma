// Esquema de Conexión500. Primer corte: solo el registro de asistentes.
//
// La cadena de conexión no va aquí: en Prisma 7 la aporta `prisma.config.ts`
// desde `DATABASE_URL`, así que el esquema no toca secretos.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Una de las 100 invitaciones. Es la llave para registrarse: el sitio dice
/// «eres uno de los 100 invitados», así que el cupo se controla aquí y no
/// contando filas de asistentes.
model Invitation {
  id        String    @id @default(cuid())
  /// Código que llega en la invitación. Se compara en mayúsculas.
  code      String    @unique
  /// Correo al que se envió, cuando se conoce. No es el del registro: quien
  /// recibe la invitación puede registrarse con otra dirección.
  email     String?
  createdAt DateTime  @default(now())
  /// Nulo mientras nadie la haya usado.
  attendee  Attendee?

  @@index([email])
}

/// A cuál de los dos eventos asiste. Son los dos actos del mismo día: la noche
/// de Natura500 y la premiación de la mañana en GET Forum.
enum EventChoice {
  NIGHT
  AWARD
}

/// En qué punto está un registro.
///
/// `PENDING` es quien ha sido **invitado por otro asistente**: de él solo se
/// conoce el nombre y el correo, porque el resto lo rellena él mismo desde el
/// enlace que le llega. `CONFIRMED` es quien completó su registro, sea por su
/// cuenta o viniendo de una invitación.
enum AttendanceStatus {
  PENDING
  CONFIRMED
  /// En lista de espera: se registró pero su correo no está en el preregistro,
  /// así que su lugar depende de que haya sitio. Lo decide el equipo.
  WAITLIST
}

/// Una persona en la lista. Puede estar **pendiente** —invitada por otra y sin
/// completar— o **confirmada**, que es el contenido del formulario de
/// `/registro`.
model Attendee {
  id     String @id @default(cuid())
  /// Identifica al asistente: un correo, un registro.
  email  String @unique
  name   String
  surname String @default("")
  /// Vacíos mientras la invitación está pendiente: de un invitado solo se sabe
  /// el nombre y el correo hasta que entra a completar su registro. Que estén
  /// vacíos no es un dato a medias por descuido, lo dice `status`.
  organization String @default("")
  role         String @default("")
  /// Opcional en el formulario; se guarda ya normalizado a URL completa.
  linkedin     String?
  /// La fotografía se sube aparte: aquí solo queda su ubicación.
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Cuándo se envió el correo de confirmación. Nulo mientras no se haya
  /// enviado: reenviar el formulario corrige los datos y no debe repetir el
  /// correo, y si el envío falla la fila queda marcada para reintentarlo.
  /// Eventos elegidos. Es una lista porque la elección es múltiple: se puede
  /// asistir a los dos. Vacía mientras el registro no haya llegado a ese paso.
  events EventChoice[]

  /// Si dijo que trae invitado. Se guarda aparte de la fila del invitado porque
  /// se responde antes de tener sus datos, y porque un `false` explícito dice
  /// algo distinto de una fila que falta.
  bringsGuest Boolean @default(false)

  /// Pendiente o confirmado. Por omisión confirmado: quien llega por el
  /// formulario lo completa entero, y solo las invitaciones nacen pendientes.
  status AttendanceStatus @default(CONFIRMED)

  /**
   * Testigo del enlace de invitación.
   *
   * Es lo que identifica al invitado cuando abre el correo, en vez del propio
   * correo: con el correo en la URL, cambiar la dirección a mano abriría el
   * registro de otra persona. Se borra al completar el registro, así que el
   * enlace deja de servir en cuanto se usa.
   */
  inviteToken  String?   @unique
  /// Cuándo salió el correo de invitación. Nulo mientras no se haya enviado.
  inviteSentAt DateTime?

  /// Quién invitó a esta persona, si llegó por invitación.
  invitedById String?
  invitedBy   Attendee?  @relation("Guests", fields: [invitedById], references: [id], onDelete: SetNull)
  /// A quién ha invitado. Es una lista por si algún día se admite más de uno.
  guests      Attendee[] @relation("Guests")

  confirmationSentAt DateTime?

  /// Cuándo se le avisó de que está en lista de espera. Va aparte de
  /// `confirmationSentAt` porque son dos correos distintos y alguien puede
  /// recibir los dos: primero el de espera y, si se le aprueba, el de
  /// confirmación.
  waitlistSentAt DateTime?

  /// A quién de la lista de preregistro corresponde, si a alguien.
  ///
  /// Se rellena de dos maneras: porque su correo estaba en la lista, o porque
  /// se reconoció en la pantalla de «¿eres tú?» al coincidir nombre y
  /// organización. Es lo que deja ver, al mirar la fila, por qué está
  /// confirmada.
  inviteeId String?   @unique
  invitee   Invitee?  @relation(fields: [inviteeId], references: [id], onDelete: SetNull)

  /// Cada invitación admite un solo registro, de ahí el `@unique`.
  invitationId String?     @unique
  invitation   Invitation? @relation(fields: [invitationId], references: [id])
}

/// Sí o no a la invitación del retiro.
enum RetreatAnswer {
  YES
  NO
}

/// Respuesta a la invitación del retiro del Consejo CEIBA en Tanusas.
///
/// Va en su propia tabla y no en `Attendee`: es otro acto, con otras preguntas
/// —ciudad desde la que se vuela, restricciones alimentarias— y con un «no» que
/// también hay que guardar. Mezclarlos habría contaminado la lista de Quito con
/// filas que no son asistentes suyos.
model RetreatRsvp {
  id String @id @default(cuid())
  /// Identifica a la persona: una respuesta por correo, y reenviar corrige.
  email        String        @unique
  name         String
  organization String        @default("")
  /// Desde dónde vuela: el equipo coordina el tramo Quito–Manta.
  city         String        @default("")
  /// Restricciones alimentarias o de salud. Opcional a propósito.
  diet         String        @default("")
  /// «Una pregunta que te importe de verdad»: entra en el diseño del retiro.
  question     String        @default("")
  answer       RetreatAnswer
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Registro al retiro de Tanusas.
///
/// Tabla propia y no `Attendee`: es otro acto, con otros campos —la ciudad desde
/// la que se vuela, las restricciones alimentarias, una pregunta— y sin nada de
/// lo que allí manda, que son los dos actos de Quito y el invitado. Mezclarlos
/// habría llenado la lista de Quito de filas que no son asistentes suyos.
///
/// Es distinto de `RetreatRsvp`, que solo recogía un sí o un no: esto es el
/// registro completo, con fotografía.
model TanusasRegistration {
  id String @id @default(cuid())
  /// Identifica a la persona: un correo, un registro, y reenviar corrige.
  email        String @unique
  name         String
  surname      String
  organization String
  role         String
  /// Desde dónde vuela: el equipo coordina el tramo Quito–Manta.
  city         String
  /// «Una pregunta que te importe de verdad»: entra en el diseño del retiro.
  question     String @default("")

  /// Restricciones alimentarias o de salud. Es una lista porque la elección es
  /// múltiple, y guarda las claves del catálogo, no la copia traducida.
  diet      String[]
  /// Detalle libre de las restricciones: una alergia concreta, una condición.
  dietNotes String   @default("")

  /// Talla de playera. Guarda la clave del catálogo ("S", "M", "L", "XL",
  /// "XXL"), que no se traduce.
  ///
  /// Por omisión vacía y no nula: la columna se añadió después de que hubiera
  /// filas, y una cadena vacía dice «todavía no la sabemos» sin obligar a
  /// distinguir dos formas de ausencia. El formulario sí la exige.
  shirtSize String @default("")

  /// La fotografía se sube aparte: aquí solo queda su ubicación. Es obligatoria
  /// en el formulario, pero la columna admite nulo para que un fallo de la
  /// subida no impida arreglar la fila a mano.
  photoUrl String?

  /// En qué idioma se registró. Decide con cuál de las dos plantillas sale el
  /// correo de confirmación: el retiro tiene una por idioma.
  locale String @default("es")

  /// Cuándo salió el correo de confirmación. Nulo mientras no se haya enviado,
  /// que es lo que impide mandarlo dos veces al corregir el registro.
  confirmationSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// El modelo `Companion` se retiró: quien viene acompañado ya no rellena los
// datos de la otra persona. Ahora indica su nombre y su correo, y esa persona
// entra en la lista como un `Attendee` en `PENDING` que completa su registro
// —sus actos, su fotografía, su credencial— desde el enlace que le llega. Un
// acompañante necesitaba exactamente lo mismo que un asistente, así que tener
// dos modelos era tener dos sitios donde arreglar lo mismo.

/// Registro de empresas e iniciativas de Ecuador a la Natura500 Night.
///
/// Tabla propia y no `Attendee` por lo mismo que el retiro: son otros campos.
/// Aquí no se elige acto —la noche es el único— y en cambio se pregunta **cómo**
/// se quiere participar: como público, o pidiendo una mesa para enseñar algo.
///
/// El aforo del cóctel es de unas 120 personas por invitación, así que lo que
/// llega aquí es una solicitud que el equipo revisa, no una plaza asignada.
model EcuadorRegistration {
  id String @id @default(cuid())

  /// Identifica a la empresa que se apunta: un correo, un registro, y reenviar
  /// corrige en vez de duplicar.
  email String @unique

  /// Tal cual se pide: un solo campo y no nombre + apellido. Quien escribe una
  /// empresa no siempre parte su nombre igual, y partirlo al guardar es inventar.
  fullName String

  /// Iniciativa, organización o empresa.
  organization String

  /// Cómo quiere participar: `attendee` o `table`. Se guarda la clave del
  /// catálogo y no el rótulo, que se traduce.
  participation String

  /// Qué producto, servicio o solución presentaría. Solo tiene sentido —y solo
  /// se pide— con `participation = "table"`.
  tablePitch String @default("")

  /// Acompañante: nombre y correo, si viene con alguien. Se guardan como texto
  /// y no como una fila aparte porque aquí no completan ningún registro propio:
  /// es un dato de aforo, no una persona con credencial.
  guestName  String @default("")
  guestEmail String @default("")

  /// La fotografía se sube aparte: aquí solo queda su ubicación.
  photoUrl String?

  /// En qué idioma se registró. Decide con cuál de las dos plantillas sale el
  /// correo de confirmación.
  locale String @default("es")

  /// Cuándo salió el correo de confirmación. Nulo mientras no se haya enviado,
  /// que es lo que impide mandarlo dos veces al corregir el registro.
  confirmationSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


/// Lista de preregistro de la Natura500 Night y el Premio.
///
/// Es la lista de invitación que decide quién queda confirmado y quién pasa a
/// lista de espera. Se siembra desde el CSV del equipo con
/// `npm run lista:importar` y se puede editar a mano; el sitio solo la lee.
///
/// No se parte el nombre en dos: en el CSV de origen la columna «Apellido»
/// trae a veces dos palabras —«Andrés Delgado»— así que el corte no es fiable y
/// lo que se compara es el nombre completo.
model Invitee {
  id String @id @default(cuid())

  /// El correo al que se envió la invitación, en minúsculas. Puede ser el de la
  /// organización y no el de la persona: en la lista hay once así.
  email String @unique

  /// Nombre completo, tal como lo escribió el equipo.
  fullName String
  /// Cargo, organización y los dos campos de contexto que trae el CSV. Ninguno
  /// decide nada: están para que quien mire la lista sepa de quién habla.
  role         String @default("")
  organization String @default("")
  sector       String @default("")
  topic        String @default("")

  /// El registro que reclamó esta invitación, si alguno. Uno por invitación:
  /// dos personas no pueden ocupar el mismo lugar.
  attendee Attendee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
