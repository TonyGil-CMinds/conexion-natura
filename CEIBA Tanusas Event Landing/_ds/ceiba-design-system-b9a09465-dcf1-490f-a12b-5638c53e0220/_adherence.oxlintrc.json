{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/social/**",
              "ui_kits/registro_web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Departure Mono|IBM Plex Mono|Host Grotesk|Cubao Free|Cubao Free Narrow|Cubao Free Wide|Bytesized|Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Departure Mono, IBM Plex Mono, Host Grotesk, Cubao Free, Cubao Free Narrow, Cubao Free Wide, Bytesized, Hanken Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|icon|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:signal|outline|gradient|ghost)$/]",
        "message": "<Button> variant must be one of 'signal' | 'outline' | 'gradient' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CeibaLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|height|key|ref|className|style|children)$/]",
        "message": "<CeibaLogo> doesn't accept that prop. Declared props: variant, tone, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='CeibaLogo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|mark)$/]",
        "message": "<CeibaLogo> variant must be one of 'lockup' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CeibaLogo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:onDark|onLight)$/]",
        "message": "<CeibaLogo> tone must be one of 'onDark' | 'onLight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountdownRuler'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|days|current|key|ref|className|style|children)$/]",
        "message": "<CountdownRuler> doesn't accept that prop. Declared props: label, days, current."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|tone|key|ref|className|style|children)$/]",
        "message": "<DataRow> doesn't accept that prop. Declared props: label, value, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:onDark|onLight)$/]",
        "message": "<DataRow> tone must be one of 'onDark' | 'onLight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|open|onToggle|tone|key|ref|className|style|children)$/]",
        "message": "<FaqRow> doesn't accept that prop. Declared props: question, answer, open, onToggle, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:onLight|onDark)$/]",
        "message": "<FaqRow> tone must be one of 'onLight' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|type|name|hint|block|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, placeholder, value, onChange, type, name, hint, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridLines'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|variant|top|key|ref|className|style|children)$/]",
        "message": "<GridLines> doesn't accept that prop. Declared props: columns, variant, top."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridLines'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|dashed)$/]",
        "message": "<GridLines> variant must be one of 'solid' | 'dashed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|tone|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: active, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:onDark|onLight)$/]",
        "message": "<NavLink> tone must be one of 'onDark' | 'onLight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartnerLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|height|key|ref|className|style|children)$/]",
        "message": "<PartnerLogo> doesn't accept that prop. Declared props: src, alt, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixelPattern'] > JSXAttribute > JSXIdentifier[name!=/^(?:pattern|assetBase|size|repeat|opacity|key|ref|className|style|children)$/]",
        "message": "<PixelPattern> doesn't accept that prop. Declared props: pattern, assetBase, size, repeat, opacity."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixelPattern'] > JSXAttribute[name.name='pattern'] > Literal[value!=/^(?:staircase|diamond|lattice|zigzag)$/]",
        "message": "<PixelPattern> pattern must be one of 'staircase' | 'diamond' | 'lattice' | 'zigzag'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixelPattern'] > JSXAttribute[name.name='repeat'] > Literal[value!=/^(?:repeat|repeat-x|repeat-y|no-repeat)$/]",
        "message": "<PixelPattern> repeat must be one of 'repeat' | 'repeat-x' | 'repeat-y' | 'no-repeat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:block|size|tone|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: block, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='block'] > Literal[value!=/^(?:warm|lime|signal|none)$/]",
        "message": "<SectionTitle> block must be one of 'warm' | 'lime' | 'signal' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:onLight|onDark)$/]",
        "message": "<SectionTitle> tone must be one of 'onLight' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|locale|tone|assetBase|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: items, active, locale, tone, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:onDark|onLight)$/]",
        "message": "<SiteHeader> tone must be one of 'onDark' | 'onLight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:platforms|color|size|gap|tone|key|ref|className|style|children)$/]",
        "message": "<SocialRow> doesn't accept that prop. Declared props: platforms, color, size, gap, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialRow'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:Negative|Original)$/]",
        "message": "<SocialRow> color must be one of 'Negative' | 'Original'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:onDark|onLight)$/]",
        "message": "<SocialRow> tone must be one of 'onDark' | 'onLight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|block|key|ref|className|style|children)$/]",
        "message": "<StatusLabel> doesn't accept that prop. Declared props: tone, size, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted|signal|onLight)$/]",
        "message": "<StatusLabel> tone must be one of 'default' | 'muted' | 'signal' | 'onLight'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:fill|image|width|flip|key|ref|className|style|children)$/]",
        "message": "<StepBlock> doesn't accept that prop. Declared props: fill, image, width, flip."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
